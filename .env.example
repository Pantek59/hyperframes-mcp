# hyperframes-mcp — example environment configuration (placeholders only; do
# not commit real values). Copy to .env and fill in.

# ── HTTP server ────────────────────────────────────────────────────────────────
MCP_TRANSPORT=http
PORT=8080
# Bearer token(s) for every endpoint except /health. Comma-separated = rotation.
# Generate one, e.g.: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=<set-a-long-random-token>

# ── Storage ──────────────────────────────────────────────────────────────────
HF_WORKSPACE=/data/projects
HF_JOBS_DIR=/data/jobs
# Global voice store for clones (independent from projects, OUTSIDE the
# workspace: the token-free /files/ route never serves it). Contains
# registry.json + samples/<name>.<ext>. One shared registry for BOTH TTS
# backends: Higgs/TTS-API (voices by name) and Fish Audio S2 (sample +
# transcript + language cloned per job on ComfyUI).
HF_VOICES_DIR=/data/voices

# ── Job queue ────────────────────────────────────────────────────────────────
HF_JOB_CONCURRENCY=1
HF_RENDER_TIMEOUT_MS=1800000
# HF_WAIT_MAX_MS=600000
# HF_JOB_TAIL_LINES=200

# ── TTS-API (/v1/audio/speech, Higgs) ────────────────────────────────────────
# Base origin only; the server appends /v1/audio/speech. Model and voice are
# required by the deployment. Keep any bearer token in this ignored .env file.
# Verify reachability from the server with the HiggsAudio_TTS tool.
TTS_API_BASE_URL=
TTS_API_MODEL=
TTS_API_VOICE=
TTS_API_API_KEY=
TTS_API_TIMEOUT_MS=300000
# Timeout for the list_voices upstream fetch (GET /v1/audio/voices)
TTS_API_LIST_TIMEOUT_MS=10000
TTS_API_MAX_TEXT_BYTES=65536
TTS_API_MAX_AUDIO_BYTES=26214400
# Voice cloning: max size of an uploaded clone sample (mp3/wav/…)
TTS_API_MAX_SAMPLE_BYTES=26214400

# ── Fish Audio TTS (ComfyUI voice cloning) ───────────────────────────────────
# ComfyUI server base origin only (e.g. http://comfyui:8188); the runner
# uploads the reference voice, POSTs /prompt and polls /history. The API key
# is only needed when a proxy in front of ComfyUI requires a bearer token.
# Check reachability with the comfyui_status tool. The first job may download
# the S2 model on the ComfyUI box — keep the timeout generous.
COMFYUI_BASE_URL=
# COMFYUI_API_KEY=
FISH_AUDIO_TIMEOUT_MS=900000
FISH_AUDIO_MAX_TEXT_BYTES=65536
FISH_AUDIO_MAX_AUDIO_BYTES=26214400
# Default language when neither the stored voice nor the call carries one
FISH_AUDIO_LANGUAGE=de
# Optional: override the Fish node's model_path widget and/or replace the
# built-in workflow with a custom API-format workflow JSON (must contain a
# Fish TTS node and a LoadAudio node).
# FISH_AUDIO_MODEL_PATH=
# FISH_AUDIO_WORKFLOW_JSON=

# ── Local CPU WhisperX ───────────────────────────────────────────────────────
WHISPERX_EXECUTABLE=/opt/whisperx-venv/bin/whisperx
WHISPERX_MODEL=base
WHISPERX_MODEL_CACHE_DIR=/data/whisperx-cache
WHISPERX_TIMEOUT_MS=1800000
WHISPERX_MAX_AUDIO_BYTES=524288000
WHISPERX_MAX_JSON_BYTES=20971520

# ── Upstream CLI ─────────────────────────────────────────────────────────────
# HF_ROOT=/app/hf
# HF_CLI=/app/hf/packages/cli/bin/hyperframes.mjs

# ── Public renders (LibreChat deployment) ───────────────────────────────────
# Public host that serves only <project>/renders/** (no trailing slash).
# When set, finished jobs include files[].url download links.
PUBLIC_BASE_URL=https://files.example.net
# Unguessable render filenames (default true). false = legacy CLI naming.
HF_RANDOMIZE_OUTPUT=true
# Optional server-side second layer: restrict /files/ to <project>/renders/**
# (leave empty when off; "true" = renders, or a CSV list of prefixes).
HF_FILES_PUBLIC_PREFIX_ONLY=
