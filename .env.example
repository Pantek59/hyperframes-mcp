# hyperframes-mcp — example environment configuration (placeholders only; do
# not commit real values). Copy to .env and fill in.

# ── HTTP server ─────────────────────────────────────────────────────────────────
MCP_TRANSPORT=http
PORT=8080
# Bearer token(s) for every endpoint except /health. Comma-separated = rotation.
# Generate one, e.g.: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=<set-a-long-random-token>

# ── Storage ───────────────────────────────────────────────────────────────────
HF_WORKSPACE=/data/projects
HF_JOBS_DIR=/data/jobs

# ── Job queue ─────────────────────────────────────────────────────────────────
HF_JOB_CONCURRENCY=1
HF_RENDER_TIMEOUT_MS=1800000
# HF_WAIT_MAX_MS=600000
# HF_JOB_TAIL_LINES=200

# ── Upstream CLI ───────────────────────────────────────────────────────────────
# HF_ROOT=/app/hf
# HF_CLI=/app/hf/packages/cli/bin/hyperframes.mjs

# ── Public renders (LibreChat deployment) ────────────────────────────
# Public host that serves only <project>/renders/** (no trailing slash).
# When set, finished jobs include files[].url download links.
PUBLIC_BASE_URL=https://files.example.net
# Unguessable render filenames (default true). false = legacy CLI naming.
HF_RANDOMIZE_OUTPUT=true
# Optional server-side second layer: restrict /files/ to <project>/renders/**
# (leave empty when off; "true" = renders, or a CSV list of prefixes).
HF_FILES_PUBLIC_PREFIX_ONLY=
